# ─────────────────────────────────────────────────────────────────────────────
# HACK.Pay — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hedera Network ────────────────────────────────────────────────────────────
# Which Hedera network to use. Options: testnet, mainnet
HACK_PAY_HEDERA_NETWORK=testnet

# ── Receiver Account ─────────────────────────────────────────────────────────
# The Hedera account that receives HBAR payments (your wallet)
# Format: 0.0.XXXXX
HACK_PAY_RECEIVER_ACCOUNT_ID=0.0.REPLACE_ME

# ── Facilitator ──────────────────────────────────────────────────────────────
# Blocky402 (recommended — supports testnet AND mainnet):
#   Testnet: https://api.testnet.blocky402.com
#   Mainnet: https://api.blocky402.com
# x402.org (testnet only — for quickstart/dev):
#   https://x402.org/facilitator
HACK_PAY_FACILITATOR_URL=https://api.testnet.blocky402.com

# ── Idempotency Store ─────────────────────────────────────────────────────────
# Options: memory (dev/test), redis (production)
HACK_PAY_IDEMPOTENCY_BACKEND=memory

# Redis — required only when HACK_PAY_IDEMPOTENCY_BACKEND=redis
# HACK_PAY_REDIS_URL=redis://localhost:6379/0

# ── Observability ─────────────────────────────────────────────────────────────
HACK_PAY_LOG_LEVEL=INFO

# ── Testnet-only: test account for running tests/testnet/
# (separate from your app receiver — use a funded testnet account)
# HACK_PAY_TESTNET_ACCOUNT_ID=0.0.REPLACE_ME
# HACK_PAY_TESTNET_PRIVATE_KEY=REPLACE_WITH_ED25519_HEX_KEY_NEVER_COMMIT
